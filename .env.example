# ==============================================================================
# HỆ THỐNG QUẢN LÝ THƯ VIỆN - CẤU HÌNH MÔI TRƯỜNG MẪU (.env.example)
# Hướng dẫn: Sao chép file này thành .env và thay đổi mật khẩu mạnh trước khi chạy.
# LỆNH: cp .env.example .env (Linux/macOS) hoặc copy .env.example .env (Windows)
# ==============================================================================

# --- Cấu hình Ứng dụng Flask ---
SECRET_KEY=change_this_to_a_random_secure_hex_secret_key_in_production
FLASK_ENV=production
FLASK_DEBUG=0
APP_PORT=5000

# --- Cấu hình Cơ sở dữ liệu PostgreSQL ---
POSTGRES_USER=library_user
POSTGRES_PASSWORD=ChangeThisSecurePassword123!
POSTGRES_DB=library_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://library_user:ChangeThisSecurePassword123!@db:5432/library_db

# --- Cấu hình pgAdmin 4 ---
PGADMIN_DEFAULT_EMAIL=admin@library.local
PGADMIN_DEFAULT_PASSWORD=ChangePgAdminPassword123!
PGADMIN_PORT=5050

# --- Cấu hình Nginx Reverse Proxy ---
HTTP_PORT=80
HTTPS_PORT=443

# --- Cấu hình Giám sát Prometheus & Grafana ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=ChangeGrafanaAdmin123!

# --- Cấu hình Centralized Logging (Loki & Promtail) ---
LOKI_PORT=3100
